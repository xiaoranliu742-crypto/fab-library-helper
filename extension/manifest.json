{
  "manifest_version": 3,
  "name": "Fab 免费素材助手",
  "version": "1.2.0",
  "author": "jushan",
  "description": "在当前 Fab 网页显示悬浮面板，核对零元授权后批量加入素材库。支持暂停、自动滚动和结果导出。",
  "permissions": ["storage"],
  "content_scripts": [{
    "matches": ["https://www.fab.com/*"],
    "js": ["core.js", "content.js"],
    "run_at": "document_idle",
    "all_frames": false
  }],
  "action": { "default_title": "Fab 免费素材助手", "default_popup": "popup.html" }
}
