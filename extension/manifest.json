{
  "manifest_version": 3,
  "name": "Fab 免费素材助手",
  "version": "1.5.4",
  "author": "菊山",
  "description": "在当前 Fab 网页批量领取零元素材，支持 Quixel 全库低内存分页、断点续扫、暂停与结果导出。",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.fab.com/*"
      ],
      "js": [
        "core.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Fab 免费素材助手",
    "default_popup": "popup.html"
  }
}
